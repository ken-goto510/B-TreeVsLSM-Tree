{
  "family": "db-benchmark-scylladb",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "4096",
  "memory": "12288",
  "ephemeralStorage": { "sizeInGiB": 40 },
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::074213351472:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::074213351472:role/ecsTaskRole-worker",
  "containerDefinitions": [
    {
      "name": "scylladb-benchmark",
      "image": "074213351472.dkr.ecr.us-east-1.amazonaws.com/bench/scylla:5.4",
      "essential": true,
      "memory": 8192,
      "command": [
        "--smp", "2",
        "--memory", "6G",
        "--overprovisioned", "1",
        "--rpc-address", "0.0.0.0",
        "--broadcast-rpc-address", "127.0.0.1"
      ],
      "portMappings": [{ "containerPort": 9042, "protocol": "tcp" }],
      "healthCheck": {
        "command": ["CMD-SHELL", "cqlsh -e 'SELECT now() FROM system.local' 127.0.0.1 9042 || exit 1"],
        "interval": 30, "timeout": 10, "retries": 10, "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/db-benchmark",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "scylla",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "benchmark-app",
      "image": "074213351472.dkr.ecr.us-east-1.amazonaws.com/b-treevslsm-tree-app:latest",
      "essential": true,
      "memory": 3072,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "BENCHMARK_SCYLLA_HOSTS",    "value": "localhost" },
        { "name": "BENCHMARK_SCYLLA_PORT",     "value": "9042" },
        { "name": "BENCHMARK_ENABLED_ENGINES", "value": "SCYLLADB" },
        { "name": "BENCHMARK_MODE",            "value": "worker" },
        { "name": "BENCHMARK_S3_BUCKET",       "value": "db-benchmark-results-074213351472" }
      ],
      "dependsOn": [
        { "containerName": "scylladb-benchmark", "condition": "HEALTHY" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"],
        "interval": 15, "timeout": 5, "retries": 5, "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/db-benchmark",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app-scylladb",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
